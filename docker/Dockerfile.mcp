FROM python:3.12-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    fastmcp==2.14.5 \
    llama-index==0.14.13 \
    torch --index-url https://download.pytorch.org/whl/cpu \
    transformers \
    sentence-transformers

# Copy server files
COPY Server/ ./Server/

WORKDIR /app/Server

EXPOSE 8003

CMD ["python", "mcp_server.py"]

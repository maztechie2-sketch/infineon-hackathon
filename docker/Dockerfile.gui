FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.111.0 \
    "uvicorn[standard]" \
    python-multipart \
    fastmcp==2.14.5 \
    requests \
    aiofiles

# Copy project files
COPY code/ ./code/
COPY gui/ ./gui/

WORKDIR /app/gui/backend

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
